---
// Floating sidebar nav — animated expand/collapse
---

<nav id="sidebar-nav" class="hidden lg:flex fixed left-6 top-1/2 -translate-y-1/2 z-40 flex-col floating-nav">
  <a href="#about" class="nav-item no-effect" data-section="about">
    <span class="nav-dot"></span>
    <span class="nav-label">about</span>
  </a>
  <a href="#experience" class="nav-item no-effect" data-section="experience">
    <span class="nav-dot"></span>
    <span class="nav-label">experience</span>
  </a>
  <a href="#projects" class="nav-item no-effect" data-section="projects">
    <span class="nav-dot"></span>
    <span class="nav-label">projects</span>
  </a>
  <a href="#musings" class="nav-item no-effect" data-section="musings">
    <span class="nav-dot"></span>
    <span class="nav-label">musings</span>
  </a>
</nav>

<style>
  .floating-nav {
    gap: 4px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    padding: 10px 12px;
    background: color-mix(in srgb, var(--v8-surface) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--v8-ash);
    border-radius: 8px;
    text-decoration: none;
    color: var(--v8-stone);
    font-family: var(--font-code);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    cursor: pointer;
    white-space: nowrap;
    transition:
      border-color 0.3s ease,
      background 0.3s ease,
      color 0.3s ease,
      transform 0.3s ease;
  }

  .nav-item:hover {
    border-color: var(--v8-warm);
    color: var(--v8-bone);
    transform: translateX(4px);
  }

  .nav-item.active {
    border-color: var(--v8-warm);
    background: var(--v8-warm-dim);
    color: var(--v8-warm);
  }

  .nav-dot {
    width: 6px;
    height: 6px;
    min-width: 6px;
    border-radius: 50%;
    background: var(--v8-stone);
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .nav-item:hover .nav-dot,
  .nav-item.active .nav-dot {
    background: var(--v8-warm);
    box-shadow: 0 0 8px var(--v8-warm-glow);
  }

  .nav-label {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    width: 0;
    opacity: 0;
    margin-left: 0;
  }
</style>

<script is:inline>
  (function () {
    function initSidebarNav() {
      var nav = document.getElementById('sidebar-nav');
      if (!nav) return;

      if (window.location.pathname !== '/') {
        nav.style.display = 'none';
        return;
      }

      var items = nav.querySelectorAll('.nav-item');
      var labels = nav.querySelectorAll('.nav-label');
      var sections = ['about', 'experience', 'projects', 'musings'];

      // Measure natural widths of labels
      var targetWidths = [];
      labels.forEach(function (label) {
        label.style.width = 'auto';
        label.style.opacity = '1';
        label.style.marginLeft = '10px';
        targetWidths.push(label.offsetWidth);
        label.style.width = '0px';
        label.style.opacity = '0';
        label.style.marginLeft = '0px';
      });

      var animId = null;
      var expanding = false;
      var progress = 0; // 0 = collapsed, 1 = expanded
      var DURATION = 200; // ms
      var lastTime = null;

      function easeOutCubic(t) {
        return 1 - Math.pow(1 - t, 3);
      }

      function animate(timestamp) {
        if (lastTime === null) lastTime = timestamp;
        var dt = timestamp - lastTime;
        lastTime = timestamp;

        if (expanding) {
          progress = Math.min(1, progress + dt / DURATION);
        } else {
          progress = Math.max(0, progress - dt / DURATION);
        }

        var eased = easeOutCubic(progress);

        labels.forEach(function (label, i) {
          label.style.width = (eased * targetWidths[i]) + 'px';
          label.style.opacity = eased;
          label.style.marginLeft = (eased * 10) + 'px';
        });

        if ((expanding && progress < 1) || (!expanding && progress > 0)) {
          animId = requestAnimationFrame(animate);
        } else {
          animId = null;
          lastTime = null;
        }
      }

      function startAnim(expand) {
        expanding = expand;
        lastTime = null;
        if (!animId) {
          animId = requestAnimationFrame(animate);
        }
      }

      nav.addEventListener('mouseenter', function () { startAnim(true); });
      nav.addEventListener('mouseleave', function () { startAnim(false); });

      // Intersection Observer for active state
      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var id = entry.target.id;
              items.forEach(function (item) {
                item.classList.toggle('active', item.getAttribute('data-section') === id);
              });
            }
          });
        },
        { rootMargin: '-30% 0px -60% 0px' }
      );

      sections.forEach(function (id) {
        var el = document.getElementById(id);
        if (el) observer.observe(el);
      });
    }

    initSidebarNav();
    document.addEventListener('astro:after-swap', initSidebarNav);
  })();
</script>
