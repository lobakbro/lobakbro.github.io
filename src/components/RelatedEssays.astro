---
import type { CollectionEntry } from 'astro:content';

interface Props {
  currentEssay: CollectionEntry<'essays'>;
  allEssays: CollectionEntry<'essays'>[];
}

const { currentEssay, allEssays } = Astro.props;

function findRelatedEssays(current: CollectionEntry<'essays'>, essays: CollectionEntry<'essays'>[], limit = 3) {
  return essays
    .filter(essay =>
      essay.id !== current.id &&
      !essay.data.draft
    )
    .map(essay => {
      let score = 0;
      if (essay.data.category === current.data.category) score += 10;
      const currentTags = current.data.tags || [];
      const essayTags = essay.data.tags || [];
      const sharedTags = currentTags.filter((tag: string) => essayTags.includes(tag));
      score += sharedTags.length * 5;
      return { essay, score };
    })
    .filter(item => item.score > 0)
    .sort((a, b) => b.score - a.score)
    .slice(0, limit)
    .map(item => item.essay);
}

const relatedEssays = findRelatedEssays(currentEssay, allEssays);
---

{relatedEssays.length > 0 && (
  <section class="mt-20 pt-12" style="border-top: 1px solid var(--v8-deep);">
    <span class="section-label">// related_essays</span>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 mt-6">
      {relatedEssays.map((essay) => (
        <article class="group">
          <a href={`/essays/${essay.id}/`} class="block no-effect">
            <div class="v8-card h-full">
              <div class="flex items-center gap-2 mb-2 text-xs">
                <span class="category-pill">{essay.data.category}</span>
                {essay.data.readingTime && (
                  <span class="font-code text-xs" style="color: var(--v8-ash);">
                    {essay.data.readingTime}
                  </span>
                )}
              </div>
              <h4 class="font-display font-semibold group-hover:opacity-80 transition-opacity mb-2" style="color: var(--v8-bone);">
                {essay.data.title}
              </h4>
              <p class="text-sm leading-relaxed line-clamp-2" style="color: var(--v8-stone);">
                {essay.data.description}
              </p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
</style>
