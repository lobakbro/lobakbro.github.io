---
interface Props {
  currentEssay: any;
  allEssays: any[];
}

const { currentEssay, allEssays } = Astro.props;

// Find related essays by category and tags
function findRelatedEssays(current, essays, limit = 3) {
  return essays
    .filter(essay => 
      essay.id !== current.id && 
      !essay.data.draft
    )
    .map(essay => {
      let score = 0;
      
      // Same category gets high score
      if (essay.data.category === current.data.category) {
        score += 10;
      }
      
      // Shared tags get points
      const currentTags = current.data.tags || [];
      const essayTags = essay.data.tags || [];
      const sharedTags = currentTags.filter(tag => essayTags.includes(tag));
      score += sharedTags.length * 5;
      
      return { essay, score };
    })
    .filter(item => item.score > 0)
    .sort((a, b) => b.score - a.score)
    .slice(0, limit)
    .map(item => item.essay);
}

const relatedEssays = findRelatedEssays(currentEssay, allEssays);
---

{relatedEssays.length > 0 && (
  <section class="mt-20 pt-12 border-t border-gray-800">
    <h3 class="text-xl font-display font-medium text-primary mb-8">
      Related Essays
    </h3>
    
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {relatedEssays.map((essay) => (
        <article class="group">
          <a href={`/essays/${essay.id}/`} class="block no-effect">
            <div class="p-4 rounded-lg bg-black/20 border border-gray-800 hover:border-gray-600 transition-all duration-300 hover:bg-black/40">
              <div class="flex items-center gap-2 mb-2 text-xs">
                <span class="category-pill text-xs">
                  {essay.data.category}
                </span>
                {essay.data.readingTime && (
                  <span class="text-muted font-code">
                    {essay.data.readingTime}
                  </span>
                )}
              </div>
              
              <h4 class="font-display font-medium text-primary group-hover:opacity-80 transition-opacity mb-2">
                {essay.data.title}
              </h4>
              
              <p class="text-sm font-body text-muted leading-relaxed line-clamp-2">
                {essay.data.description}
              </p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
</style>