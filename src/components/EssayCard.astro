---
interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  slug: string;
  readingTime?: string;
}

const { title, description, date, category, slug, readingTime } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<a href={`/essays/${slug}/`} class="group block no-effect">
  <article class="p-6 rounded-xl border border-gray-800 hover:border-gray-600 transition-all duration-300 bg-black/20 hover:bg-black/40 card-hover glow-on-hover">
    <div class="flex items-center gap-3 mb-3 text-sm">
      <span class="category-pill text-xs">
        {category}
      </span>
      <time class="text-muted font-medium" datetime={date.toISOString()}>
        {formattedDate}
      </time>
      {readingTime && (
        <span class="text-muted text-xs">
          {readingTime}
        </span>
      )}
    </div>
    <h3 class="text-lg font-display font-medium text-primary group-hover:opacity-80 transition-opacity mb-2">
      {title}
    </h3>
    <p class="text-sm font-body text-muted leading-relaxed line-clamp-2">
      {description}
    </p>
  </article>
</a>
