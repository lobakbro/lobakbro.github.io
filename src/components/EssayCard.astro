---
interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  slug: string;
  readingTime?: string;
}

const { title, description, date, category, slug, readingTime } = Astro.props;

const categoryColors: Record<string, string> = {
  ml: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
  research: 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200',
  music: 'bg-rose-100 text-rose-800 dark:bg-rose-900 dark:text-rose-200',
  philosophy: 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200',
  life: 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
  roundup: 'bg-teal-100 text-teal-800 dark:bg-teal-900 dark:text-teal-200',
  cybersecurity: 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200',
  projects: 'bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200',
};

const pillClass = categoryColors[category] || 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200';
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<a href={`/essays/${slug}/`} class="group block">
  <article class="p-5 rounded-lg border border-(--color-border) dark:border-(--color-border-dark) hover:border-(--color-primary) dark:hover:border-(--color-primary-dark) transition-colors">
    <div class="flex items-center gap-3 mb-2 text-sm">
      <span class:list={['category-pill', pillClass]}>{category}</span>
      <time class="text-(--color-text-muted) dark:text-(--color-text-muted-dark)" datetime={date.toISOString()}>
        {formattedDate}
      </time>
      {readingTime && (
        <span class="text-(--color-text-muted) dark:text-(--color-text-muted-dark)">{readingTime}</span>
      )}
    </div>
    <h3 class="text-lg font-semibold group-hover:text-(--color-primary) dark:group-hover:text-(--color-primary-dark) transition-colors">
      {title}
    </h3>
    <p class="mt-1 text-sm text-(--color-text-muted) dark:text-(--color-text-muted-dark) line-clamp-2">
      {description}
    </p>
  </article>
</a>
