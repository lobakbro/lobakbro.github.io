---
interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  slug: string;
  heroImage?: string;
}

const { title, description, date, category, slug, heroImage } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<a href={`/essays/${slug}/`} class="group block">
  <article class="relative overflow-hidden rounded-xl border border-(--color-border) dark:border-(--color-border-dark) hover:border-(--color-primary) dark:hover:border-(--color-primary-dark) transition-colors">
    {heroImage && (
      <img src={heroImage} alt="" class="w-full h-48 object-cover" />
    )}
    <div class="p-6">
      <div class="flex items-center gap-3 mb-3 text-sm">
        <span class="category-pill bg-(--color-accent)/20 text-(--color-accent) dark:bg-(--color-accent-dark)/20 dark:text-(--color-accent-dark) font-bold">
          Featured
        </span>
        <span class="category-pill bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300">
          {category}
        </span>
        <time class="text-(--color-text-muted) dark:text-(--color-text-muted-dark)" datetime={date.toISOString()}>
          {formattedDate}
        </time>
      </div>
      <h2 class="text-2xl font-bold group-hover:text-(--color-primary) dark:group-hover:text-(--color-primary-dark) transition-colors">
        {title}
      </h2>
      <p class="mt-2 text-(--color-text-muted) dark:text-(--color-text-muted-dark)">
        {description}
      </p>
    </div>
  </article>
</a>
