---
interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  slug: string;
  heroImage?: string;
}

const { title, description, date, category, slug, heroImage } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<a href={`/essays/${slug}/`} class="group block">
  <article class="relative overflow-hidden">
    {heroImage && (
      <img src={heroImage} alt="" class="w-full h-64 object-cover rounded-lg mb-6 opacity-90 group-hover:opacity-100 transition-opacity" />
    )}
    <div class="space-y-4">
      <div class="flex items-center gap-4 text-sm">
        <span class="category-pill">
          {category}
        </span>
        <time class="text-muted font-medium" datetime={date.toISOString()}>
          {formattedDate}
        </time>
      </div>
      <h2 class="text-3xl sm:text-4xl font-display font-semibold leading-tight text-primary group-hover:opacity-80 transition-opacity">
        {title}
      </h2>
      <p class="text-lg font-body text-muted leading-relaxed max-w-3xl">
        {description}
      </p>
    </div>
  </article>
</a>
