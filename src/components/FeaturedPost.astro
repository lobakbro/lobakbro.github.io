---
interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  slug: string;
  heroImage?: string;
}

const { title, description, date, category, slug, heroImage } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<a href={`/essays/${slug}/`} class="group block no-effect">
  <article class="relative overflow-hidden">
    {heroImage && (
      <img src={heroImage} alt="" class="w-full h-64 object-cover mb-6 opacity-90 group-hover:opacity-100 transition-opacity" />
    )}
    <div class="space-y-4">
      <div class="flex items-center gap-4 text-sm">
        <span class="category-pill">{category}</span>
        <time class="font-code text-xs" style="color: var(--v8-ash);" datetime={date.toISOString()}>
          {formattedDate}
        </time>
      </div>
      <h2 class="text-3xl sm:text-4xl font-display font-bold leading-tight group-hover:opacity-80 transition-opacity" style="color: var(--v8-bone);">
        {title}
      </h2>
      <p class="text-lg leading-relaxed max-w-3xl" style="color: var(--v8-stone);">
        {description}
      </p>
    </div>
  </article>
</a>
