---
interface Props {
  title: string;
  description: string;
  tech: string[];
  status: string;
  slug: string;
  heroImage?: string;
}

const { title, description, tech, status, slug, heroImage } = Astro.props;
---

<a href={`/projects/${slug}/`} class="group block">
  <article class="h-full rounded-xl border border-gray-800 hover:border-gray-600 transition-all duration-300 bg-black/20 hover:bg-black/40 overflow-hidden">
    {heroImage && (
      <img src={heroImage} alt="" class="w-full h-40 object-cover opacity-90 group-hover:opacity-100 transition-opacity" />
    )}
    <div class="p-6">
      <div class="flex items-center gap-2 mb-3">
        <span class="category-pill text-xs">
          {status}
        </span>
      </div>
      <h3 class="text-lg font-display font-medium text-primary group-hover:opacity-80 transition-opacity mb-2">
        {title}
      </h3>
      <p class="text-sm font-body text-muted leading-relaxed line-clamp-2 mb-4">
        {description}
      </p>
      <div class="flex flex-wrap gap-2">
        {tech.map((t) => (
          <span class="text-xs px-2 py-1 rounded-md bg-black/40 text-muted border border-gray-800 font-code">
            {t}
          </span>
        ))}
      </div>
    </div>
  </article>
</a>
