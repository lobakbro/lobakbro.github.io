---
interface Props {
  title: string;
  description: string;
  tech: string[];
  status: string;
  slug: string;
  heroImage?: string;
}

const { title, description, tech, status, slug, heroImage } = Astro.props;
---

<a href={`/projects/${slug}/`} class="group block no-effect">
  <article class="h-full v8-card glow-on-hover overflow-hidden">
    {heroImage && (
      <img src={heroImage} alt="" class="w-full h-40 object-cover opacity-90 group-hover:opacity-100 transition-opacity -mt-6 -mx-6 mb-4" style="width: calc(100% + 3rem);" />
    )}
    <div class="flex items-center gap-2 mb-3">
      <span class="category-pill">{status}</span>
    </div>
    <h3 class="text-lg font-display font-semibold group-hover:opacity-80 transition-opacity mb-2" style="color: var(--v8-bone);">
      {title}
    </h3>
    <p class="text-sm leading-relaxed line-clamp-2 mb-4" style="color: var(--v8-stone);">
      {description}
    </p>
    <div class="flex flex-wrap gap-2">
      {tech.map((t) => (
        <span class="font-code text-xs px-2 py-1" style="color: var(--v8-ash); background: var(--v8-warm-dim); border: 1px solid var(--v8-deep);">
          {t}
        </span>
      ))}
    </div>
  </article>
</a>
