---
interface Props {
  title: string;
  description: string;
  tech: string[];
  status: string;
  slug: string;
  heroImage?: string;
}

const { title, description, tech, status, slug, heroImage } = Astro.props;

const statusColors: Record<string, string> = {
  active: 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
  completed: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
  'in-progress': 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200',
  archived: 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200',
};
---

<a href={`/projects/${slug}/`} class="group block">
  <article class="h-full rounded-lg border border-(--color-border) dark:border-(--color-border-dark) hover:border-(--color-primary) dark:hover:border-(--color-primary-dark) transition-colors overflow-hidden">
    {heroImage && (
      <img src={heroImage} alt="" class="w-full h-40 object-cover" />
    )}
    <div class="p-5">
      <div class="flex items-center gap-2 mb-2">
        <span class:list={['category-pill', statusColors[status] || statusColors.completed]}>
          {status}
        </span>
      </div>
      <h3 class="text-lg font-semibold group-hover:text-(--color-primary) dark:group-hover:text-(--color-primary-dark) transition-colors">
        {title}
      </h3>
      <p class="mt-1 text-sm text-(--color-text-muted) dark:text-(--color-text-muted-dark) line-clamp-2">
        {description}
      </p>
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tech.map((t) => (
          <span class="text-xs px-2 py-0.5 rounded bg-(--color-bg-secondary) dark:bg-(--color-bg-secondary-dark) text-(--color-text-muted) dark:text-(--color-text-muted-dark)">
            {t}
          </span>
        ))}
      </div>
    </div>
  </article>
</a>
