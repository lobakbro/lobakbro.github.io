---
const navLinks = [
  { href: '/about/', label: 'about' },
  { href: '/projects/', label: 'projects' },
  { href: '/resume/', label: 'resume' },
  { href: '/essays/', label: 'musings' },
  { href: '/cats/', label: '🐱' },
];

const currentPath = Astro.url.pathname;
---

<header class="w-full" style="background-color: var(--v8-void);">
  <nav class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between">
    <a href="/" class="no-effect flex items-center gap-2 hover:opacity-80 transition-opacity">
      <span class="breathing-dot"></span>
      <span class="font-code text-sm font-medium" style="color: var(--v8-bone);">kevin_ong</span>
    </a>

    <div id="header-nav-links" class="flex items-center gap-6">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class="no-effect text-sm font-code"
          data-nav-href={href}
          style={currentPath.startsWith(href)
            ? 'color: var(--v8-warm); opacity: 1; padding: 4px 10px; border-radius: 6px; border: 1px solid rgba(212, 149, 106, 0.3); background: rgba(212, 149, 106, 0.15);'
            : 'color: var(--v8-stone); opacity: 0.6; padding: 4px 10px; border-radius: 6px; border: 1px solid transparent;'}
        >
          {label}
        </a>
      ))}
      <a
        href="mailto:kevin.mac.ong@gmail.com"
        class="cta-button no-effect hidden sm:inline-block"
      >
        [get_in_touch]
      </a>
      <button
        id="theme-toggle"
        aria-label="Toggle dark mode"
        class="p-2 transition-colors"
        style="color: var(--v8-stone);"
      >
        <svg class="w-4 h-4 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <svg class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var container = document.getElementById('header-nav-links');
    if (!container) return;
    var links = container.querySelectorAll('[data-nav-href]');
    var currentPath = window.location.pathname;

    links.forEach(function (link) {
      var href = link.getAttribute('data-nav-href');
      var isActive = currentPath.startsWith(href);

      // Set initial state via JS to guarantee it applies
      if (isActive) {
        link.style.color = 'var(--v8-warm)';
        link.style.opacity = '1';
        link.style.background = 'rgba(212, 149, 106, 0.15)';
        link.style.borderColor = 'rgba(212, 149, 106, 0.3)';
      } else {
        link.style.color = 'var(--v8-stone)';
        link.style.opacity = '0.6';
        link.style.background = 'transparent';
        link.style.borderColor = 'transparent';
      }

      link.addEventListener('mouseenter', function () {
        link.style.color = 'var(--v8-warm)';
        link.style.opacity = '1';
      });

      link.addEventListener('mouseleave', function () {
        if (isActive) {
          link.style.color = 'var(--v8-warm)';
          link.style.opacity = '1';
        } else {
          link.style.color = 'var(--v8-stone)';
          link.style.opacity = '0.6';
        }
      });
    });

    function setupThemeToggle() {
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    }
    setupThemeToggle();
    document.addEventListener('astro:after-swap', setupThemeToggle);
  })();
</script>
