---
interface Props {
  categories: string[];
  currentCategory?: string;
}

const { categories, currentCategory } = Astro.props;
---

<nav class="flex flex-wrap gap-3 mb-12">
  <a
    href="/essays/"
    class={`px-4 py-2 rounded-lg text-sm font-medium transition-all font-body ${
      !currentCategory
        ? 'bg-primary text-black'
        : 'bg-black/20 text-muted hover:bg-black/40 hover:text-primary border border-gray-800'
    }`}
  >
    All
  </a>
  {categories.map((cat) => (
    <a
      href={`/essays/${cat}/`}
      class={`px-4 py-2 rounded-lg text-sm font-medium transition-all capitalize font-body ${
        currentCategory === cat
          ? 'bg-primary text-black'
          : 'bg-black/20 text-muted hover:bg-black/40 hover:text-primary border border-gray-800'
      }`}
    >
      {cat}
    </a>
  ))}
</nav>
