---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resume } from '../data/resume';
---

<BaseLayout title="Resume" description={`${resume.name} — ${resume.title}`}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <div class="flex items-start justify-between mb-10">
      <div>
        <h1 class="text-3xl font-bold">{resume.name}</h1>
        <p class="text-lg text-(--color-text-muted) dark:text-(--color-text-muted-dark) mt-1">
          {resume.title} &middot; {resume.location}
        </p>
      </div>
      <!-- TODO: Add PDF download link -->
    </div>

    {resume.summary && (
      <section class="mb-10">
        <p class="text-lg leading-relaxed">{resume.summary}</p>
      </section>
    )}

    <!-- Experience -->
    <section class="mb-10">
      <h2 class="text-xl font-bold mb-6 pb-2 border-b border-(--color-border) dark:border-(--color-border-dark)">
        Experience
      </h2>
      <div class="space-y-8">
        {resume.experience.map((job) => (
          <div>
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-2">
              <h3 class="font-semibold text-lg">{job.role}</h3>
              <span class="text-sm text-(--color-text-muted) dark:text-(--color-text-muted-dark)">{job.period}</span>
            </div>
            <p class="text-(--color-text-muted) dark:text-(--color-text-muted-dark) mb-2">{job.company}</p>
            <ul class="space-y-1">
              {job.highlights.map((h) => (
                <li class="text-sm pl-4 relative before:content-['–'] before:absolute before:left-0 before:text-(--color-text-muted) dark:before:text-(--color-text-muted-dark)">
                  {h}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Skills -->
    <section class="mb-10">
      <h2 class="text-xl font-bold mb-6 pb-2 border-b border-(--color-border) dark:border-(--color-border-dark)">
        Skills
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {Object.entries(resume.skills).map(([category, items]) => (
          <div>
            <h3 class="font-medium mb-2">{category}</h3>
            <div class="flex flex-wrap gap-1.5">
              {items.map((skill) => (
                <span class="text-sm px-2.5 py-1 rounded-full bg-(--color-bg-secondary) dark:bg-(--color-bg-secondary-dark)">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Education -->
    {resume.education.some((e) => e.institution) && (
      <section class="mb-10">
        <h2 class="text-xl font-bold mb-6 pb-2 border-b border-(--color-border) dark:border-(--color-border-dark)">
          Education
        </h2>
        <div class="space-y-6">
          {resume.education.filter((e) => e.institution).map((edu) => (
            <div>
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-1">
                <h3 class="font-semibold">{edu.degree}</h3>
                <span class="text-sm text-(--color-text-muted) dark:text-(--color-text-muted-dark)">{edu.period}</span>
              </div>
              <p class="text-(--color-text-muted) dark:text-(--color-text-muted-dark)">{edu.institution}</p>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
