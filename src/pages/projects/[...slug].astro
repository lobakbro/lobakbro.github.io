---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="category-pill bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
          {project.data.status}
        </span>
        {project.data.repo && (
          <a href={project.data.repo} class="text-sm text-(--color-primary) dark:text-(--color-primary-dark) hover:underline">
            GitHub &rarr;
          </a>
        )}
        {project.data.demo && (
          <a href={project.data.demo} class="text-sm text-(--color-primary) dark:text-(--color-primary-dark) hover:underline">
            Demo &rarr;
          </a>
        )}
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold leading-tight">
        {project.data.title}
      </h1>
      <p class="mt-4 text-lg text-(--color-text-muted) dark:text-(--color-text-muted-dark)">
        {project.data.description}
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        {project.data.tech.map((t) => (
          <span class="text-sm px-3 py-1 rounded-full bg-(--color-bg-secondary) dark:bg-(--color-bg-secondary-dark) text-(--color-text-muted) dark:text-(--color-text-muted-dark)">
            {t}
          </span>
        ))}
      </div>
    </header>

    <div class="prose mx-auto">
      <Content />
    </div>
  </article>
</BaseLayout>
