---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-20">
    <!-- Back navigation -->
    <nav class="mb-12">
      <a href="/projects/" class="text-sm font-medium text-muted hover:text-primary transition-opacity inline-flex items-center gap-2">
        ← Back to Projects
      </a>
    </nav>

    <header class="mb-16 pb-12 border-b border-gray-800">
      <div class="flex items-center gap-4 mb-6">
        <span class="category-pill">
          {project.data.status}
        </span>
        {project.data.repo && (
          <a href={project.data.repo} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-primary hover:opacity-80 transition-opacity">
            GitHub →
          </a>
        )}
        {project.data.demo && (
          <a href={project.data.demo} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-primary hover:opacity-80 transition-opacity">
            Demo →
          </a>
        )}
      </div>
      
      <h1 class="text-4xl sm:text-5xl font-display font-semibold leading-tight text-primary mb-8">
        {project.data.title}
      </h1>
      
      <p class="text-xl font-body text-muted leading-relaxed max-w-3xl mb-6">
        {project.data.description}
      </p>

      <div class="flex flex-wrap gap-3">
        {project.data.tech.map((t) => (
          <span class="text-xs px-3 py-2 rounded-lg bg-black/40 text-muted border border-gray-800 font-code">
            {t}
          </span>
        ))}
      </div>
    </header>

    <div class="prose max-w-none">
      <Content />
    </div>

    <!-- Project footer -->
    <footer class="mt-20 pt-12 border-t border-gray-800">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div>
          <p class="text-sm font-body text-muted">
            Status: <span class="text-primary">{project.data.status}</span>
          </p>
        </div>
        <div class="flex gap-6">
          <a href="/projects/" class="text-sm font-medium text-primary hover:opacity-80 transition-opacity">
            ← More Projects
          </a>
          <a href="/essays/" class="text-sm font-medium text-primary hover:opacity-80 transition-opacity">
            Essays
          </a>
        </div>
      </div>
    </footer>
  </article>
</BaseLayout>
