---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <article class="max-w-4xl mx-auto px-6 py-20">
    <nav class="mb-12">
      <a href="/projects/" class="no-effect font-code text-sm hover:opacity-80 transition-opacity" style="color: var(--v8-stone);">
        ← back to projects
      </a>
    </nav>

    <header class="mb-16 pb-12" style="border-bottom: 1px solid var(--v8-deep);">
      <div class="flex items-center gap-4 mb-6">
        <span class="category-pill">{project.data.status}</span>
        {project.data.repo && (
          <a href={project.data.repo} target="_blank" rel="noopener noreferrer" class="no-effect font-code text-xs hover:opacity-80 transition-opacity" style="color: var(--v8-warm);">
            view source ↗
          </a>
        )}
        {project.data.demo && (
          <a href={project.data.demo} target="_blank" rel="noopener noreferrer" class="no-effect font-code text-xs hover:opacity-80 transition-opacity" style="color: var(--v8-warm);">
            [live_demo ↗]
          </a>
        )}
      </div>

      <h1 class="text-4xl sm:text-5xl font-display font-bold leading-tight mb-8" style="color: var(--v8-bone);">
        {project.data.title}
      </h1>

      <p class="text-xl leading-relaxed max-w-3xl mb-6" style="color: var(--v8-stone);">
        {project.data.description}
      </p>

      <div class="flex flex-wrap gap-3">
        {project.data.tech.map((t) => (
          <span class="font-code text-xs px-3 py-2" style="color: var(--v8-ash); background: var(--v8-warm-dim); border: 1px solid var(--v8-deep);">
            {t}
          </span>
        ))}
      </div>
    </header>

    <div class="prose max-w-none">
      <Content />
    </div>

    <footer class="mt-20 pt-12" style="border-top: 1px solid var(--v8-deep);">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <p class="font-code text-xs" style="color: var(--v8-ash);">
          status: <span style="color: var(--v8-warm);">{project.data.status}</span>
        </p>
        <div class="flex gap-6">
          <a href="/projects/" class="no-effect font-code text-sm hover:opacity-80 transition-opacity" style="color: var(--v8-warm);">
            ← more projects
          </a>
          <a href="/essays/" class="no-effect font-code text-sm hover:opacity-80 transition-opacity" style="color: var(--v8-warm);">
            essays
          </a>
        </div>
      </div>
    </footer>
  </article>
</BaseLayout>
