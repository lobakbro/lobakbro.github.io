---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EssayCard from '../components/EssayCard.astro';
import { resume } from '../data/resume';

const allEssays = await getCollection('essays', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});
const sortedEssays = allEssays.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = sortedEssays.filter((e) => e.data.featured).slice(0, 2);
const miniEssays = sortedEssays.filter((e) => !e.data.featured).slice(0, 4);

const allProjects = await getCollection('projects', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});
const topProject = allProjects.find((p) => p.data.title.startsWith('Constellation')) || allProjects[0];

// Top 3 experience entries for homepage
const topExperience = resume.experience.slice(0, 3);
---

<BaseLayout title="KMO">
  <div class="max-w-3xl mx-auto px-6">
    <!-- ═══ Hero ═══ -->
    <section id="about" class="pt-20 sm:pt-28 pb-16">
      <h1 id="hero-name" class="text-5xl sm:text-6xl lg:text-7xl font-display font-extrabold tracking-tight leading-[1.05]" style="color: var(--v8-bone); opacity: 0;">
        Kevin M. Ong
      </h1>
      <script is:inline>
        (function () {
          var el = document.getElementById('hero-name');
          if (!el) return;
          var original = el.textContent.trim();
          var chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789@#$%&*';
          var letters = original.split('');
          var display = letters.map(function (c) {
            return c === ' ' || c === '.' ? c : chars.charAt(Math.floor(Math.random() * chars.length));
          });

          // Show scrambled text immediately
          el.textContent = display.join('');
          el.style.opacity = '1';

          var current = 0;
          function revealNext() {
            if (current >= letters.length) return;
            var i = current;
            current++;
            if (letters[i] === ' ' || letters[i] === '.') {
              setTimeout(revealNext, 40);
              return;
            }
            var flips = 0;
            var timer = setInterval(function () {
              flips++;
              if (flips >= 5) {
                clearInterval(timer);
                display[i] = letters[i];
                el.textContent = display.join('');
              } else {
                display[i] = chars.charAt(Math.floor(Math.random() * chars.length));
                el.textContent = display.join('');
              }
            }, 40);
            setTimeout(revealNext, 50);
          }

          // Delay start so user sees the scrambled state first
          setTimeout(revealNext, 400);
        })();
      </script>
      <p class="mt-4 font-code text-sm" style="color: var(--v8-stone);" data-reveal data-reveal-delay="1">
        software_engineer // san_francisco
      </p>

      <div class="mt-10 relative pl-10" data-reveal data-reveal-delay="2">
        <span class="absolute left-0 top-0 font-display text-5xl leading-none" style="color: var(--v8-warm); opacity: 0.4;">"</span>
        <p class="text-xl sm:text-2xl font-display font-medium leading-snug" style="color: var(--v8-bone);">
          Every big problem is just a bunch of small problems.<br/>
          Just solve the small problems.
        </p>
      </div>

      <p class="mt-8 text-base leading-relaxed max-w-2xl" style="color: var(--v8-stone);" data-reveal data-reveal-delay="3">
        Engineer. Started in research, now designing and delivering systems at scale. My startup is using agents to build personalized coding teaching socratic tutor. This site is where I write about what I'm learning along the way.
      </p>

      <div class="mt-8 flex flex-wrap gap-6 font-code text-sm" data-reveal data-reveal-delay="4">
        <a href={resume.contact.linkedin} target="_blank" rel="noopener noreferrer" class="no-effect hover:opacity-80 transition-opacity" style="color: var(--v8-stone);">linkedin</a>
        <a href="/resume/" class="no-effect hover:opacity-80 transition-opacity" style="color: var(--v8-stone);">resume</a>
      </div>
    </section>

    <div class="gradient-divider"></div>

    <!-- ═══ Story ═══ -->
    <section class="py-16">
      <span class="section-label" data-reveal>// the_short_version</span>

      <div class="mt-8 space-y-6 text-base leading-relaxed" style="color: var(--v8-stone);">
        <p data-reveal>
          I got into engineering through brain probes — three years in Ed Boyden's lab at UTD and MIT McGovern, building electrode arrays and mapping neurons in 3D as a McDermott Scholar. The ML work there led to a research internship at Citi doing deep learning validation for mortgage stress testing, and that led to Palo Alto Networks where I won a hackathon automating secret detection across production repos.
        </p>
        <p data-reveal>
          At Desktop Metal I joined a tiny R&D team building a 3D printer nobody had made before — scrolling DLP projector, overlap artifacts at the hardware-software boundary, messy Python prototypes becoming production C++ APIs.
        </p>
        <div class="pl-6 py-3 my-4" style="border-left: 3px solid var(--v8-warm);" data-reveal>
          <p style="color: var(--v8-bone);">
            Now at IvyBee I built all the backend for experiential gaming experiences — clean room simulations delivered as interactive game worlds. Designed the whole cloud stack: CosmosDB, Kubernetes, a proxy gateway that routes players between pods with state sync in Go.
          </p>
        </div>
        <p data-reveal>
          The through-line: every role has been a zero-to-one build. Prototype to production, across domains I had to learn on the job.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap gap-4 font-code text-xs" style="color: var(--v8-ash);" data-reveal>
        {['python', 'go', 'c++', 'typescript', 'kubernetes', 'azure', 'llms', 'signal_processing'].map((t) => (
          <span>{t}</span>
        ))}
      </div>
    </section>

    <div class="gradient-divider"></div>

    <!-- ═══ Experience ═══ -->
    <section id="experience" class="py-16">
      <div class="flex items-center justify-between mb-10" data-reveal>
        <span class="section-label">// experience</span>
        <a href="/resume/" class="no-effect font-code text-xs hover:opacity-80 transition-opacity" style="color: var(--v8-warm);">
          view full resume →
        </a>
      </div>

      <div class="space-y-4">
        {topExperience.map((job, i) => (
          <div class="v8-card" data-reveal data-reveal-delay={String(i + 1)}>
            <div class="flex flex-col sm:flex-row sm:items-start gap-4">
              <span class="font-code text-xs shrink-0 pt-1" style="color: var(--v8-ash);">{job.period.split('–')[0].trim()} →</span>
              <div class="flex-1">
                <h3 class="font-display font-semibold" style="color: var(--v8-bone);">{job.role}</h3>
                <p class="font-code text-xs mt-1" style="color: var(--v8-warm);">{job.company}</p>
                <p class="text-sm mt-3 leading-relaxed" style="color: var(--v8-stone);">
                  {job.highlights[0]}
                </p>
                {job.highlights.length > 1 && (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {job.highlights.slice(1, 3).map((h) => (
                      <span class="font-code text-xs px-2 py-0.5" style="color: var(--v8-ash); background: var(--v8-warm-dim);">
                        {h.split(' ').slice(0, 4).join(' ')}...
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <div class="gradient-divider"></div>

    <!-- ═══ Projects ═══ -->
    <section id="projects" class="py-16">
      <span class="section-label" data-reveal>// projects</span>

      {topProject && (
        <a href={`/projects/${topProject.id}/`} class="group block no-effect mt-10 p-8" style="background: var(--v8-surface); border: 1px solid var(--v8-deep); border-left: 3px solid var(--v8-warm);" data-reveal>
          <div class="flex items-start justify-between mb-4">
            <h3 class="text-xl font-display font-bold group-hover:opacity-80 transition-opacity" style="color: var(--v8-bone);">{topProject.data.title}</h3>
          </div>
          <p class="text-sm leading-relaxed mb-6" style="color: var(--v8-stone);">
            {topProject.data.description}
          </p>
          <div class="flex flex-wrap gap-8 items-end">
            <div>
              <span class="text-3xl font-display font-bold" style="color: var(--v8-warm);">BKT</span>
              <p class="font-code text-xs mt-1" style="color: var(--v8-ash);">knowledge_tracing</p>
            </div>
            <div>
              <span class="text-lg font-code font-semibold" style="color: var(--v8-bone);">FSRS</span>
              <p class="font-code text-xs mt-1" style="color: var(--v8-ash);">spaced_repetition</p>
            </div>
            <div>
              <span class="text-lg font-display font-semibold" style="color: var(--v8-bone);">Claude</span>
              <p class="font-code text-xs mt-1" style="color: var(--v8-ash);">drill_gen</p>
            </div>
          </div>
        </a>
      )}

      {allProjects.length > 1 && (
        <div class="mt-4 text-right">
          <a href="/projects/" class="no-effect font-code text-xs hover:opacity-80 transition-opacity" style="color: var(--v8-warm);">
            view all projects →
          </a>
        </div>
      )}
    </section>

    <div class="gradient-divider"></div>

    <!-- ═══ Musings ═══ -->
    <section id="musings" class="py-16">
      <span class="section-label" data-reveal>// musings</span>

      {featured.length > 0 && (
        <div class="mt-10 grid gap-6 sm:grid-cols-2" data-reveal>
          {featured.map((essay) => (
            <a href={`/essays/${essay.id}/`} class="group block no-effect v8-card">
              <div class="flex items-center gap-2 mb-3">
                <span class="category-pill">{essay.data.category}</span>
                <span class="font-code text-xs" style="color: var(--v8-ash);">
                  {essay.data.readingTime || 'essay'}
                </span>
              </div>
              <h3 class="font-display font-semibold group-hover:opacity-80 transition-opacity" style="color: var(--v8-bone);">
                {essay.data.title}
              </h3>
            </a>
          ))}
        </div>
      )}

      {miniEssays.length > 0 && (
        <div class="mt-6">
          <span class="section-label" data-reveal>// mini essays</span>
          <div class="mt-4 grid gap-3 sm:grid-cols-2" data-reveal>
            {miniEssays.map((essay) => (
              <a
                href={`/essays/${essay.id}/`}
                class="no-effect group flex items-center gap-3 py-3 px-4 transition-all hover:translate-x-1"
                style="background: var(--v8-surface); border: 1px solid var(--v8-deep);"
              >
                <span class="font-code text-xs shrink-0" style="color: var(--v8-ash);">→</span>
                <span class="text-sm font-medium group-hover:opacity-80 transition-opacity" style="color: var(--v8-bone);">
                  {essay.data.title}
                </span>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="mt-4 text-right">
        <a href="/essays/" class="no-effect font-code text-xs hover:opacity-80 transition-opacity" style="color: var(--v8-warm);">
          view all musings →
        </a>
      </div>
    </section>

    <div class="gradient-divider"></div>

    <!-- ═══ Closing ═══ -->
    <section class="py-16 pb-24">
      <div class="p-10 text-center" style="background: var(--v8-warm-dim); border: 1px solid var(--v8-warm-glow);" data-reveal>
        <p class="text-base italic leading-relaxed max-w-2xl mx-auto" style="color: var(--v8-stone);">
          I want to work where AI makes the person better, not just the output better. If you're building learning tools, developer infrastructure, or something nobody's built before — I'd like to talk.
        </p>
        <div class="mt-8" data-reveal data-reveal-delay="1">
          <a href="mailto:kevin.mac.ong@gmail.com" class="cta-button no-effect text-base px-8 py-3">
            [get_in_touch]
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
