---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import EssayCard from '../components/EssayCard.astro';
import ProjectCard from '../components/ProjectCard.astro';

const allEssays = await getCollection('essays', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});
const sortedEssays = allEssays.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = sortedEssays.filter((e) => e.data.featured);
const recent = sortedEssays.filter((e) => !e.data.featured).slice(0, 6);

const allProjects = await getCollection('projects', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});
const featuredProjects = allProjects
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="KMO">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <!-- Hero -->
    <section class="py-20 sm:py-32">
      <h1 class="text-5xl sm:text-6xl font-display font-semibold tracking-tight leading-tight text-primary">
        Kevin M. Ong
      </h1>
      <p class="mt-6 text-xl sm:text-2xl max-w-3xl font-body leading-relaxed text-muted">
        Building at the intersection of human agency and machine intelligence. 
        Essays on agentic collaboration, learning systems, and the ideas that shape how we work with AI.
      </p>
    </section>

    <!-- Major Articles -->
    {featured.length > 0 && (
      <section class="mb-20">
        <h2 class="text-2xl font-display font-semibold text-primary mb-8 tracking-tight">Major Articles</h2>
        <div class="space-y-12">
          {featured.map((essay) => (
            <article class="border-b border-(--color-border-dark) pb-12 last:border-b-0" style="border-color: var(--color-border-dark);">
              <FeaturedPost
                title={essay.data.title}
                description={essay.data.description}
                date={essay.data.date}
                category={essay.data.category}
                slug={essay.id}
                heroImage={essay.data.heroImage}
              />
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Mini-Essays & Recent Writing -->
    {recent.length > 0 && (
      <section class="mb-20">
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-xl font-display font-medium text-primary">Recent Writing</h2>
          <a href="/essays/" class="text-sm font-medium text-primary hover:opacity-80 transition-opacity">
            View all →
          </a>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {recent.map((essay) => (
            <EssayCard
              title={essay.data.title}
              description={essay.data.description}
              date={essay.data.date}
              category={essay.data.category}
              slug={essay.id}
              readingTime={essay.data.readingTime}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Selected Work -->
    {featuredProjects.length > 0 && (
      <section class="mb-16">
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-xl font-display font-medium text-primary">Selected Work</h2>
          <a href="/projects/" class="text-sm font-medium text-primary hover:opacity-80 transition-opacity">
            View all →
          </a>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {featuredProjects.map((project) => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              tech={project.data.tech}
              status={project.data.status}
              slug={project.id}
              heroImage={project.data.heroImage}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
