---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="This page doesn't exist, but there are many others worth exploring.">
  <div class="max-w-3xl mx-auto px-6 py-20 text-center">
    <h1 class="text-6xl sm:text-7xl font-display font-bold mb-6" style="color: var(--v8-warm);">
      404
    </h1>

    <h2 class="text-2xl sm:text-3xl font-display font-medium mb-6" style="color: var(--v8-bone);">
      Page not found
    </h2>

    <p class="text-lg leading-relaxed mb-12 max-w-xl mx-auto" style="color: var(--v8-stone);">
      The page you're looking for doesn't exist. But while you're here,
      perhaps you'd like to explore some essays on agentic collaboration,
      meditation practice, or why Sibelius belongs to winter.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/" class="cta-button no-effect">
        back home
      </a>
      <a
        href="/essays/"
        class="no-effect font-code text-sm px-5 py-2.5 transition-all hover:opacity-80"
        style="color: var(--v8-stone); background: var(--v8-surface); border: 1px solid var(--v8-deep);"
      >
        browse essays
      </a>
    </div>

    <div class="mt-16 pt-8" style="border-top: 1px solid var(--v8-deep);">
      <p class="font-code text-xs" style="color: var(--v8-ash); opacity: 0.6;">
        > cat /dev/random | head -1<br/>
        "Not all who wander are lost, but this URL definitely is."
      </p>
    </div>
  </div>
</BaseLayout>
