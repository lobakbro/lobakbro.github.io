---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="This page doesn't exist, but there are many others worth exploring.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-20 text-center">
    <h1 class="text-6xl sm:text-7xl font-display font-semibold text-primary mb-6">
      404
    </h1>
    
    <h2 class="text-2xl sm:text-3xl font-display font-medium text-primary mb-6">
      Page Not Found
    </h2>
    
    <p class="text-lg font-body text-muted mb-12 max-w-xl mx-auto leading-relaxed">
      The page you're looking for doesn't exist. But while you're here, 
      perhaps you'd like to explore some essays on agentic collaboration, 
      meditation practice, or why Sibelius belongs to winter.
    </p>

    <div class="space-y-4 sm:space-y-0 sm:space-x-6 sm:flex sm:justify-center">
      <a 
        href="/" 
        class="inline-block px-6 py-3 bg-primary text-black font-medium rounded-lg hover:opacity-90 transition-opacity"
      >
        Back Home
      </a>
      <a 
        href="/essays/" 
        class="inline-block px-6 py-3 bg-black/40 text-primary border border-gray-800 font-medium rounded-lg hover:bg-black/60 transition-colors"
      >
        Browse Essays
      </a>
    </div>

    <!-- Easter egg for developers -->
    <div class="mt-16 pt-8 border-t border-gray-800">
      <p class="text-sm font-code text-muted opacity-60">
        > cat /dev/random | head -1<br/>
        "Not all who wander are lost, but this URL definitely is."
      </p>
    </div>
  </div>
</BaseLayout>